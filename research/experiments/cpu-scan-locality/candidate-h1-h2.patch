+    /// Hint a row's cache lines into L1 ahead of its dot product. Scattered eligible slots restart
+    /// the hardware stream prefetcher at every gap; out-of-range slots are ignored.
+    #[inline(always)]
+    fn prefetch_row(&self, slot: u32) {
+        #[cfg(target_arch = "x86_64")]
+        {
+            use std::arch::x86_64::{_MM_HINT_T0, _mm_prefetch};
+            let start = slot as usize * self.lanes_per_row;
+            if let Some(lanes) = self.vectors.get(start..start + self.lanes_per_row) {
+                // Two 32-byte lanes per 64-byte line.
+                for lane in lanes.iter().step_by(2) {
+                    // SAFETY: SSE is in the x86_64 baseline and a prefetch never faults.
+                    #[allow(unused_unsafe)]
+                    unsafe {
+                        _mm_prefetch::<_MM_HINT_T0>((lane as *const Lane).cast::<i8>())
+                    };
+                }
+            }
+        }
+        #[cfg(not(target_arch = "x86_64"))]
+        let _ = slot;
+    }

{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "Qenlo Design Tokens",
  "version": "1.0.0",
  "description": "Design tokens for Qenlo Brandkit and UI components",
  "qenlo": {
    "color": {
      "light": {
        "background": {
          "$value": "#F7F5F0",
          "$type": "color",
          "description": "Default background for light mode"
        },
        "text": {
          "$value": "#1D2320",
          "$type": "color",
          "description": "Default primary text for light mode"
        },
        "muted-text": {
          "$value": "#5A615D",
          "$type": "color",
          "description": "Secondary / muted body text for light mode"
        },
        "accent": {
          "$value": "#B53C2F",
          "$type": "color",
          "description": "Primary brand accent color for light mode"
        },
        "on-accent": {
          "$value": "#FFFFFF",
          "$type": "color",
          "description": "Text / glyph color on top of accent fill"
        },
        "surface": {
          "$value": "#EFECE6",
          "$type": "color",
          "description": "Card, panel, and table row surface for light mode"
        },
        "surface-raised": {
          "$value": "#E6E2DA",
          "$type": "color",
          "description": "Elevated container, popover, or modal surface for light mode"
        },
        "border": {
          "$value": "#D8D3C8",
          "$type": "color",
          "description": "Default subtle divider and card border for light mode"
        },
        "border-strong": {
          "$value": "#878E8A",
          "$type": "color",
          "description": "High-contrast border for inputs and active controls in light mode"
        },
        "focus": {
          "$value": "#B53C2F",
          "$type": "color",
          "description": "Focus ring indicator color for light mode"
        }
      },
      "dark": {
        "background": {
          "$value": "#171C19",
          "$type": "color",
          "description": "Default background for dark mode"
        },
        "text": {
          "$value": "#F7F5F0",
          "$type": "color",
          "description": "Default primary text for dark mode"
        },
        "muted-text": {
          "$value": "#AAB3AD",
          "$type": "color",
          "description": "Secondary / muted body text for dark mode"
        },
        "accent": {
          "$value": "#EF8B79",
          "$type": "color",
          "description": "Primary brand accent color for dark mode"
        },
        "on-accent": {
          "$value": "#171C19",
          "$type": "color",
          "description": "Text / glyph color on top of accent fill in dark mode"
        },
        "surface": {
          "$value": "#1F2622",
          "$type": "color",
          "description": "Card, panel, and table row surface for dark mode"
        },
        "surface-raised": {
          "$value": "#2A332E",
          "$type": "color",
          "description": "Elevated container, popover, or modal surface for dark mode"
        },
        "border": {
          "$value": "#2E3833",
          "$type": "color",
          "description": "Default subtle divider and card border for dark mode"
        },
        "border-strong": {
          "$value": "#6E7C74",
          "$type": "color",
          "description": "High-contrast border for inputs and active controls in dark mode"
        },
        "focus": {
          "$value": "#EF8B79",
          "$type": "color",
          "description": "Focus ring indicator color for dark mode"
        }
      }
    },
    "font-family": {
      "sans": {
        "$value": "'IBM Plex Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
        "$type": "fontFamily",
        "description": "Primary UI and editorial sans-serif font stack"
      },
      "mono": {
        "$value": "'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace",
        "$type": "fontFamily",
        "description": "Code, coordinate, tabular and telemetry monospace font stack"
      }
    },
    "font-weight": {
      "regular": {
        "$value": 400,
        "$type": "fontWeight",
        "description": "Normal body copy weight"
      },
      "semibold": {
        "$value": 600,
        "$type": "fontWeight",
        "description": "Emphasis, headings, and key metric weight"
      }
    },
    "font-size": {
      "xs": {
        "$value": "0.75rem",
        "pixelValue": "12px",
        "lineHeight": "1rem",
        "$type": "dimension",
        "description": "Extra small labels, captions, metadata"
      },
      "sm": {
        "$value": "0.875rem",
        "pixelValue": "14px",
        "lineHeight": "1.25rem",
        "$type": "dimension",
        "description": "Small body, UI controls, navigation items"
      },
      "base": {
        "$value": "1rem",
        "pixelValue": "16px",
        "lineHeight": "1.5rem",
        "$type": "dimension",
        "description": "Default body copy, standard inputs"
      },
      "lg": {
        "$value": "1.125rem",
        "pixelValue": "18px",
        "lineHeight": "1.75rem",
        "$type": "dimension",
        "description": "Subheadings, lead paragraphs, card titles"
      },
      "xl": {
        "$value": "1.375rem",
        "pixelValue": "22px",
        "lineHeight": "1.875rem",
        "$type": "dimension",
        "description": "Section headers, modal titles"
      },
      "2xl": {
        "$value": "1.75rem",
        "pixelValue": "28px",
        "lineHeight": "2.25rem",
        "$type": "dimension",
        "description": "Page headers, primary panel titles"
      },
      "3xl": {
        "$value": "2.25rem",
        "pixelValue": "36px",
        "lineHeight": "2.75rem",
        "$type": "dimension",
        "description": "Hero display headers, hero metrics"
      }
    },
    "space": {
      "1": {
        "$value": "0.25rem",
        "pixelValue": "4px",
        "$type": "dimension",
        "description": "4px micro spacing, tight padding"
      },
      "2": {
        "$value": "0.5rem",
        "pixelValue": "8px",
        "$type": "dimension",
        "description": "8px compact gap, button horizontal padding"
      },
      "3": {
        "$value": "0.75rem",
        "pixelValue": "12px",
        "$type": "dimension",
        "description": "12px intermediate spacing"
      },
      "4": {
        "$value": "1rem",
        "pixelValue": "16px",
        "$type": "dimension",
        "description": "16px standard container and gutter padding"
      },
      "6": {
        "$value": "1.5rem",
        "pixelValue": "24px",
        "$type": "dimension",
        "description": "24px medium section spacing"
      },
      "8": {
        "$value": "2rem",
        "pixelValue": "32px",
        "$type": "dimension",
        "description": "32px large component gap"
      },
      "12": {
        "$value": "3rem",
        "pixelValue": "48px",
        "$type": "dimension",
        "description": "48px layout spacing"
      },
      "16": {
        "$value": "4rem",
        "pixelValue": "64px",
        "$type": "dimension",
        "description": "64px major section padding"
      }
    }
  }
}
